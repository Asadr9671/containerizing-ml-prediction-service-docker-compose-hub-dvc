# Replace local with your public Docker Hub username before publishing.
DOCKERHUB_USERNAME=asad3390
IMAGE_TAG=1.0.0
MODEL_VERSION=1.0.0
# Set to git rev-parse HEAD before building.
GIT_SHA=local
# Host port; the container always listens on 8000.
API_PORT=8000
MODEL_PATH=artifacts/model.joblib
DECISION_THRESHOLD=0.5
LOG_LEVEL=INFO
# Compose uses service name redis. Unset REDIS_HOST for standalone usage.
REDIS_HOST=redis
REDIS_PORT=6379
